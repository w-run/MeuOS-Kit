#!/bin/bash
# quickstart - 子项目自动化工作流入口 (调用 ci-driver)
#
# 这是仓库根目录的**唯一**开发者入口脚本,负责:
#   1. 动态发现 projects/*/ 下的子项目
#   2. 把"项目名"解析成"传给 ci-driver 的 --projects 列表"
#   3. 透传剩余参数给 tools/ci-driver/ci_driver.py run
#
# 设计原则:
#   - **不**硬编码子项目名(除一个 mcc-libc 绑定别名外),所以新增子项目
#     无需改本脚本
#   - **不**实现 todo 调度/状态管理/accept 检查,这些都在 ci-driver 内部
#     (本脚本仅是 Python 驱动的薄包装)
#   - quickstart 自己的 flag (--list/--help/--all) 必须出现在 `--` 之前
#     之后的 token 一律透传给 ci_driver (Python argparse 不接受 `--`,
#     所以 quickstart 负责把 `--` 剥掉再传过去)
#
# 用法:
#   ./quickstart                        # 列出子项目 + 用法
#   ./quickstart <sub>                  # 跑该 sub 的 ci-driver (--projects <sub>)
#   ./quickstart <a,b,c>                # 跑多个
#   ./quickstart mcc-libc               # 绑定别名 = mcc + meuos-libc
#   ./quickstart --all                  # 跑所有
#   ./quickstart <sub> -- --once        # 透传 ci_driver 参数 (用 -- 分隔)
#   ./quickstart <sub> -- --batch-size 1 --max-rounds 5
#   ./quickstart --list                 # 只列子项目
#   ./quickstart --help
#
# 退出码: 等同 ci_driver run (0=本轮完成 / 非 0=有失败 todo 或参数错)

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECTS_DIR="${REPO_ROOT}/projects"
CI_DRIVER="${REPO_ROOT}/tools/ci-driver/ci_driver.py"

# 唯一允许的"硬编码名字":绑定组别名
# 含义:用户写 mcc-libc 时,quickstart 解析为 mcc,meuos-libc 两个 sub
# 之后这个列表就**只**服务于这个别名,新增子项目不需要动这里
declare -A BOUND_ALIAS=(
    ["mcc-libc"]="mcc,meuos-libc"
    ["mcc+libc"]="mcc,meuos-libc"
)

log()  { printf '[quickstart] %s\n' "$*" >&2; }
fail() { printf '[quickstart][FATAL] %s\n' "$*" >&2; exit 1; }

usage() {
    sed -n '3,30p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 0
}

# 列子项目: projects/<name>/Makefile 存在才算
list_subprojects() {
    local d
    for d in "${PROJECTS_DIR}"/*/; do
        [[ -d "$d" ]] || continue
        [[ -f "${d}/Makefile" ]] || continue
        basename "$d"
    done | sort
}

# 把一个 token (子项目名或绑定别名) 解析成逗号分隔的子项目列表
# 校验每个 sub 存在 + 有 Makefile
resolve_subprojects() {
    local token="$1"
    # 1) 绑定别名?
    if [[ -n "${BOUND_ALIAS[$token]:-}" ]]; then
        token="${BOUND_ALIAS[$token]}"
    fi
    # 2) 逗号分割
    local IFS=','
    local -a subs
    read -ra subs <<< "$token"
    for s in "${subs[@]}"; do
        local d="${PROJECTS_DIR}/${s}"
        [[ -d "$d" ]]            || fail "subproject not found: ${s} (try --list)"
        [[ -f "${d}/Makefile" ]] || fail "subproject ${s} has no Makefile"
    done
    # 输出 (逗号连接回原顺序)
    (IFS=','; echo "${subs[*]}")
}

# ---- preflight -----------------------------------------------------------

[[ -d "${PROJECTS_DIR}" ]]        || fail "projects/ not found at ${PROJECTS_DIR}"
[[ -f "${CI_DRIVER}"     ]]       || fail "ci_driver.py not found at ${CI_DRIVER}"
[[ -x "$(command -v python3)" ]]  || fail "python3 not in PATH"

# ---- arg parse -----------------------------------------------------------
# 形态:
#   ./quickstart                     → 列出 (默认行为)
#   ./quickstart --list              → 同上
#   ./quickstart --help              → 帮助
#   ./quickstart --all [ci_args...]  → --projects = 所有
#   ./quickstart <sub> [ci_args...]  → --projects = <sub>
#   <sub> 后面 token 之前可以加 `--` 显式分界 (quickstart 自己的 flag 必须在 `--` 之前)

ACTION_LIST=0
SUBS_TOKEN=""
CI_ARGS=()
SEEN_DDASH=0

while [[ $# -gt 0 ]]; do
    if [[ "${SEEN_DDASH}" -eq 1 ]]; then
        CI_ARGS+=("$1")
        shift
        continue
    fi
    case "$1" in
        --help|-h)         usage ;;
        --list)            ACTION_LIST=1; shift ;;
        --all)             SUBS_TOKEN="__ALL__"; shift ;;
        --)                SEEN_DDASH=1; shift ;;
        -*)                fail "unknown quickstart flag: $1 (use '--' to pass flags to ci-driver, e.g. 'meow -- --batch-size 1')" ;;
        *)
            if [[ -n "${SUBS_TOKEN}" && "${SUBS_TOKEN}" != "__ALL__" ]]; then
                # 多个连续 positional token,合并为逗号列表
                SUBS_TOKEN="${SUBS_TOKEN},$1"
            elif [[ -z "${SUBS_TOKEN}" ]]; then
                SUBS_TOKEN="$1"
            else
                # SUBS_TOKEN == __ALL__,不应该再有 positional
                fail "unexpected positional after --all: $1"
            fi
            shift
            ;;
    esac
done

# ---- dispatch -----------------------------------------------------------

if [[ "${ACTION_LIST}" -eq 1 ]]; then
    echo "Available subprojects (auto-discovered from projects/*/):"
    list_subprojects | sed 's/^/  - /'
    echo ""
    echo "Bound aliases (mcc + meuos-libc are coupled in the bootstrap chain):"
    for k in "${!BOUND_ALIAS[@]}"; do echo "  - $k -> ${BOUND_ALIAS[$k]}"; done | sort
    echo ""
    echo "Pass --help for full usage."
    exit 0
fi

if [[ -z "${SUBS_TOKEN}" ]]; then
    # 默认行为: 列子项目
    echo "Available subprojects (auto-discovered from projects/*/):"
    list_subprojects | sed 's/^/  - /'
    echo ""
    echo "Bound aliases (mcc + meuos-libc are coupled in the bootstrap chain):"
    for k in "${!BOUND_ALIAS[@]}"; do echo "  - $k -> ${BOUND_ALIAS[$k]}"; done | sort
    echo ""
    echo "Pass --help for full usage."
    exit 0
fi

if [[ "${SUBS_TOKEN}" == "__ALL__" ]]; then
    SUBS_TOKEN="$(list_subprojects | paste -sd ',' -)"
    [[ -n "${SUBS_TOKEN}" ]] || fail "no subprojects discovered under ${PROJECTS_DIR}"
fi

RESOLVED="$(resolve_subprojects "${SUBS_TOKEN}")"
log "subprojects: ${RESOLVED}"
log "ci-driver:   ${CI_DRIVER}"
[[ ${#CI_ARGS[@]} -gt 0 ]] && log "ci-args:     ${CI_ARGS[*]}"

# 透传给 ci_driver run: project_root (位置) + --projects + 剩余 args
# 注意 Python argparse 不接受 `--` token,所以 `--` 已经在上面被吞掉了
exec python3 "${CI_DRIVER}" "${REPO_ROOT}" \
    --projects "${RESOLVED}" \
    "${CI_ARGS[@]}"
