# 密钥配置（不入仓）—— 复制为 secret.yaml 并填入真实 key。
#
# 读取优先级：env > 此文件 > 默认行为。
#
# 用法：
#   cp secret.yaml.example secret.yaml
#   chmod 600 secret.yaml
#   编辑 secret.yaml 填入真实 API key
#   或直接: export NVIDIA_API_KEY=nvapi-...

# NVIDIA NIM REST API（OpenAI 兼容）
nvidia_nim:
    api_key: nvapi-REPLACE-ME

# 通用 providers（任何 provider 都可以放在这里）
providers:
    minimax:
        api_key: sk-cp-REPLACE-ME
    arkcli:
        api_key: ark-REPLACE-ME
