name: meow
version: 1.0
default: meow

[variables]
  BLD: /workspace/MeuOS-Kit/projects/meow/build
  SRC: /workspace/MeuOS-Kit/projects/meow/src
  MCC: /workspace/MeuOS-Kit/projects/mcc/mcc
  CFLAGS: --specs=meuos --sysroot=/workspace/MeuOS-Kit/projects/sysroot --nostdlib -I%SRC%
  LDLIBS: -l:libc-meuos.a

[meow]
  outputs: %BLD%/meow
  run: |
    mkdir -p %BLD%
    %MCC% %CFLAGS% -I%SRC% -c %SRC%/main.c -o %BLD%/main.o
    %MCC% %CFLAGS% -I%SRC% -c %SRC%/state.c -o %BLD%/state.o
    %MCC% %CFLAGS% -I%SRC% -c %SRC%/exec.c -o %BLD%/exec.o
    %MCC% %CFLAGS% -I%SRC% -c %SRC%/recipe.c -o %BLD%/recipe.o
    %MCC% %CFLAGS% -I%SRC% -c %SRC%/parse.c -o %BLD%/parse.o
    %MCC% %CFLAGS% -I%SRC% -c %SRC%/graph.c -o %BLD%/graph.o
    %MCC% %CFLAGS% -I%SRC% -c %SRC%/probe.c -o %BLD%/probe.o
    %MCC% %CFLAGS% -o %BLD%/meow %BLD%/main.o %BLD%/state.o %BLD%/exec.o %BLD%/recipe.o %BLD%/parse.o %BLD%/graph.o %BLD%/probe.o %LDLIBS%

[clean]
  run: rm -rf %BLD%
