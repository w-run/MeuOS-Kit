+/* Supplement functions missing from meuos-libc that dash needs.
+ * These are called without #ifdef guards in dash source code.
+ */
+#include <string.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+
+/* Like strncpy but returns pointer to the null terminator in dest. */
+char *stpncpy(char *dest, const char *src, size_t n)
+{
+	char *d = dest;
+	while (n > 0 && *src != '\0') {
+		*d++ = *src++;
+		n--;
+	}
+	while (n > 0) {
+		*d++ = '\0';
+		n--;
+	}
+	return d;
+}
+
+/* sys_siglist for strsignal() fallback in system.c */
+const char *sys_siglist[32] = {
+	[0]  = "Signal 0",
+	[1]  = "Hangup",
+	[2]  = "Interrupt",
+	[3]  = "Quit",
+	[4]  = "Illegal instruction",
+	[5]  = "Trace/breakpoint trap",
+	[6]  = "Aborted",
+	[7]  = "Bus error",
+	[8]  = "Floating point exception",
+	[9]  = "Killed",
+	[10] = "User defined signal 1",
+	[11] = "Segmentation fault",
+	[12] = "User defined signal 2",
+	[13] = "Broken pipe",
+	[14] = "Alarm clock",
+	[15] = "Terminated",
+	[16] = "Stack fault",
+	[17] = "Child exited",
+	[18] = "Continued",
+	[19] = "Stopped (signal)",
+	[20] = "Stopped",
+	[21] = "Stopped (tty input)",
+	[22] = "Stopped (tty output)",
+	[23] = "Urgent I/O condition",
+	[24] = "CPU time limit exceeded",
