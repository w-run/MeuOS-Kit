+	[26] = "Virtual timer expired",
+	[27] = "Profiling timer expired",
+	[28] = "Window changed",
+	[29] = "I/O possible",
+	[30] = "Power failure",
+	[31] = "Bad system call",
+};
+
+/* Job control stubs - return error so dash disables job control */
+pid_t tcgetpgrp(int fd)
+{
+	(void)fd;
+	return -1;
+}
+
+int tcsetpgrp(int fd, pid_t pgrp)
+{
+	(void)fd;
+	(void)pgrp;
+	return -1;
+}
+
+pid_t getpgrp(void)
+{
+	return -1;
+}
+
+int setpgid(pid_t pid, pid_t pgid)
+{
+	(void)pid;
+	(void)pgid;
+	return -1;
+}
+
+/* wait3 is BSD: wait3(status, options, rusage) */
+pid_t wait3(int *status, int options, void *rusage)
+{
+	(void)rusage;
+	return waitpid(-1, status, options);
+}
+
+/* getppid stub - libc-meuos has no getppid */
+pid_t getppid(void)
+{
+	return 0;
+}
