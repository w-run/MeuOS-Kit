name: meow-macros
version: 1.0
# CC 用宿主 cc（mcc 不在 PATH 上）；%CC% --version 需在 run(!) 下成功
env: CC=cc, CFLAGS=-O2

[clean]
  phony: true
  run: rm -f /tmp/meow-macro-test.txt

[build]
  run(!): %CC% --version
  run(?): false
  run(?): echo "continue after false" > /tmp/meow-macro-test.txt
  run(q): echo "quiet command" > /dev/null
