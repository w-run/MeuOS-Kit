
*~
*.a
# AI agent config: canonical home is .agents; .codebuddy/.trae are symlink aliases.
# Local runtime data (moved out of the old .codebuddy/ dir) lives under .agents now.
.agents/settings.json
.agents/scheduled_tasks.lock
.agents/worktrees/
a.out
# Auto-generated bootstrap run report
bootstrap-report.md
# bootstrap staging
build/
# Build artifacts (per-component output dirs)
# Built compiler/runtime binaries (not in build/ subdirs)
.codebuddy/
config.h
# QEMU configure generates temporary config-test files
config-temp/
config.log
# Core dumps from test binaries under QEMU
*.core
dl/
# Do NOT edit or commit. MeuOS Kit is source-level integrated, not vendored.
.DS_Store
# Editor / OS noise
env/build/
env/kernels/*.apk
env/kernels/*/Image
env/kernels/*/vmlinuz
env/rootfs/
env/run/
env/share/*
# env/share/ is a runtime working dir for host<->guest file transfer;
!env/share/README.txt
# experimentation sandboxes (Alpine rootfs, etc.)
experiments/
# mcc / qbe intermediate files
# meow download/build staging
meuos-libc/build/
meuos-libc-compat/build/
*.o
# only its README is tracked.
out/
pkg-build/
projects/mcc/mcc
*.qbe
# QEMU test environment (env/) - large binaries, not tracked
reference/
# Reference source trees (cproc + QBE), pulled read-only for design reference.
*.s
*.so
*.so.*
sources/
*.ssa
stage/
.*.swp
sysroot/
.vscode/
*.msys
