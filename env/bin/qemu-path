#!/bin/bash
# 输出 MeuOS Kit 自建的 qemu-system-x86_64 路径（KVM+9p）。
# 供 MeuOS 2026 集成用：  QEMU_BIN=$(./qemu-path) /workspace/MeuOS/builder/scripts/run-vm.sh
# 支持参数指定架构： qemu-path [x86_64|i386|aarch64]（默认 x86_64）
ARCH="${1:-x86_64}"
DIR="/usr/local/qemu/qemu-${ARCH}/bin"
BIN="$DIR/qemu-system-$ARCH"
if [ ! -x "$BIN" ]; then
  echo "qemu-system-$ARCH 未构建：运行 env/build/build-qemu.sh" >&2
  exit 1
fi
echo "$BIN"
