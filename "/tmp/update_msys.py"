import json
d = json.load(open('/workspace/static/mcc-toolchain/data.json'))
for comp in d['components']:
    if comp['id'] == 'sysroot':
        comp['progress'] = 75
        for t in comp['todos']:
            if '错误提示友好' in t['text']:
                t['status'] = 'done'
            elif '优雅降级' in t['text']:
                t['status'] = 'done'
            elif '--fast' in t['text'] or '进度' in t['text']:
                t['status'] = 'done'
        break
json.dump(d, open('/workspace/static/mcc-toolchain/data.json','w'), indent=2, ensure_ascii=False)
print('OK')