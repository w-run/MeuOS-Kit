#!/bin/sh
# as_locallabel.sh - numeric local label (Nf/Nb) regression gate.
#
# Verifies that mt/as correctly resolves forward (1f) and backward (1b)
# references to numeric local labels.  Defect fixed in commit 43c72b5d.
set -eu

as=${1:?mt/as path required}
ld=${2:-}

work=$(mktemp -d /tmp/mt-as-locallabel.XXXXXX)
trap 'rm -rf "$work"' EXIT HUP INT TERM
fail=0

# ---- Test 1: forward reference (1f) ----
# jmp 1f should jump to the nearest 1: label BELOW the jump.
# That label sets %eax=60, then syscall exit(60).
cat >"$work/fwd.s" <<'ASM'
.text
.globl _start
_start:
	jmp 1f
	mov $1, %rax
1:	mov $42, %rax
1:	mov $60, %eax
	syscall
ASM

"$as" --target=x86_64 -o "$work/fwd.o" "$work/fwd.s" 2>"$work/fwd.err" || {
	echo "FAIL (fwd): assemble error: $(cat $work/fwd.err)"
	fail=1
}

if [ -n "$ld" ]; then
	"$ld" -o "$work/fwd" "$work/fwd.o" 2>/dev/null || true
	if [ -f "$work/fwd" ]; then
		set +e
		"$work/fwd"
		rc=$?
		set -e
		[ "$rc" = 60 ] || {
			echo "FAIL (fwd): exit=$rc (expected 60, forward jump mis-resolved)"
			fail=1
		}
	fi
fi
echo "  forward (1f): exit=$rc OK"

# ---- Test 2: backward reference (1b) ----
# 1b should jump to the MOST RECENT 1: label above the jump.
cat >"$work/bwd.s" <<'ASM'
.text
.globl _start
_start:
1:	mov $60, %eax
	jmp 1f
	mov $99, %eax
1:	jmp 1b
	mov $99, %eax
	syscall
ASM

"$as" --target=x86_64 -o "$work/bwd.o" "$work/bwd.s" 2>"$work/bwd.err" || {
	echo "FAIL (bwd): assemble error: $(cat $work/bwd.err)"
	fail=1
}
echo "  backward (1b): assemble OK"

# ---- Test 3: multiple same-number labels ----
# Three labels numbered 1: should all be valid (GAS compat).
cat >"$work/multi.s" <<'ASM'
.text
.globl _start
_start:
1:	nop
1:	nop
1:	nop
	mov $60, %eax
	syscall
ASM

"$as" --target=x86_64 -o "$work/multi.o" "$work/multi.s" 2>"$work/multi.err" || {
	echo "FAIL (multi): assemble error: $(cat $work/multi.err)"
	fail=1
}
echo "  multi-def: assemble OK"

# ---- Test 4: per-function scope ----
# Each function's 2: is local to that function.
cat >"$work/scope.s" <<'ASM'
.text
.globl _start
_start:
	jmp 2f
	nop
2:	mov $60, %eax
	syscall
ASM

"$as" --target=x86_64 -o "$work/scope.o" "$work/scope.s" 2>"$work/scope.err" || {
	echo "FAIL (scope): assemble error: $(cat $work/scope.err)"
	fail=1
}
echo "  per-function scope: assemble OK"

if [ "$fail" -ne 0 ]; then
	echo "mt/as local-label: FAILED"
	exit 1
fi
echo "mt/as local-label: all checks PASS"