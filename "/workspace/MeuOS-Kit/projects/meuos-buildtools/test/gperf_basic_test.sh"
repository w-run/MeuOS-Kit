"#!/bin/sh\n# gperf_basic_test.sh — Test gperf perfect hash generator\nset -eu\n\nbuildtools=\"${1:?buildtools path required}\"\n\npass=0\ntotal=0\n\n# 1: --help\ntotal=$((total+1)) && \"$buildtools\" gperf --help >/dev/null 2>&1 \\\n    && echo \"PASS: --help\" && pass=$((pass+1)) \\\n    || echo \"FAIL: --help\"\n\n# 2: --version\ntotal=$((total+1)) && \"$buildtools\" gperf --version >/dev/null 2>&1 \\\n    && echo \"PASS: --version\" && pass=$((pass+1)) \\\n    || echo \"FAIL: --version\"\n\n# 3: Generate perfect hash for 4 keywords\ntotal=$((total+1)) && r=$(printf '%%\\nalpha\\nbeta\\ngamma\\ndelta' | \"$buildtools\" gperf 2>/dev/null) \\\n    && echo \"$r\" | grep -q 'TOTAL_KEYWORDS 4' \\\n    && echo \"PASS: 4 keywords hashed\" && pass=$((pass+1)) \\\n    || echo \"FAIL: 4 keywords hashed\"\n\n# 4: Generated C compiles\ntotal=$((total+1)) && \\\n    printf '%%\\nalpha\\nbeta\\ngamma\\ndelta' | \"$buildtools\" gperf 2>/dev/null > /tmp/gperf_test.c \\\n    && cc -O2 -std=c11 -Wall -Wextra -Werror -x c -c -o /tmp/gperf_test.o /tmp/gperf_test.c 2>&1 \\\n    && echo \"PASS: compiles clean\" && pass=$((pass+1)) \\\n    || echo \"FAIL: compiles clean\"\n\n# 5: Generated code lookup works\ntotal=$((total+1)) && \\\n    printf '#include <stdio.h>\\n' > /tmp/gperf_run.c \\\n    && printf '%%\\nalpha\\nbeta\\ngamma\\ndelta' | \"$buildtools\" gperf 2>/dev/null >> /tmp/gperf_run.c \\\n    && printf 'int main(void) {\n  const char *r = in_word_set(\"alpha\",5); if(!r){printf(\"FAIL\\\\n\");return 1;}\n  r = in_word_set(\"beta\",4); if(!r){printf(\"FAIL\\\\n\");return 1;}\n  r = in_word_set(\"unknown\",7); if(r){printf(\"FAIL\\\\n\");return 1;}\n  printf(\"PASS\\\\n\"); return 0; }\\n' >> /tmp/gperf_run.c \\\n    && cc -O2 -std=c11 -Wall -Wextra -Werror -o /tmp/gperf_run /tmp/gperf_run.c 2>&1 \\\n    && result=$(/tmp/gperf_run) && [ \"$result\" = \"PASS\" ] \\\n    && echo \"PASS: lookup works\" && pass=$((pass+1)) \\\n    || echo \"FAIL: lookup works (result=$result)\"\n\nrm -f /tmp/gperf_test.c /tmp/gperf_test.o /tmp/gperf_run.c /tmp/gperf_run\n\necho\nif [ \"$pass\" -eq \"$total\" ]; then\n    echo \"=== ALL $total GPERF TESTS PASSED ===\"\nelse\n    echo \"=== $pass/$total TESTS PASSED ===\"\n    exit 1\nfi"